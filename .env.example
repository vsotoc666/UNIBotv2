AWS_S3_ENDPOINT_URL=https://xxxx.supabase.co/storage/v1/s3

# --- TELEGRAM ---
TELEGRAM_BOT_TOKEN=tu_bot_token_aqui

# --- GOOGLE GENAI ---
GEMINI_API_KEY=tu_gemini_api_key_aqui

# --- URL PÚBLICA DE LA APLICACIÓN ---
