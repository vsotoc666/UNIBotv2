# --- DJANGO ---
DJANGO_SECRET_KEY=tu_secret_key_aqui
DEBUG=True

# --- SUPABASE (DATABASE & STORAGE) ---
DATABASE_URL=postgres://postgres.xxxx:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=disable
